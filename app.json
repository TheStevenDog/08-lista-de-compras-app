{
  "expo": {
    "name": "Lista de Compras Compartible",
    "slug": "08-lista-de-compras-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "listacompras",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.examenmovil.listacompras",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación únicamente mientras la app está abierta para avisarte cuando estés a menos de 300 metros de un supermercado guardado."
      }
    },
    "android": {
      "package": "com.examenmovil.listacompras",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite avisarte si estás cerca (< 300 m) de un supermercado guardado."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
